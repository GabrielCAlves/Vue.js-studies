  ".nx-divider--vertical {",
  "  flex-direction: column;",
  "  align-self: stretch;",
  "  min-height: 24px;",
  "  margin: 0 var(--c-gap);",
  "}",
  "",
  ".nx-divider--vertical::before,",
  ".nx-divider--vertical::after {",
  "  content: \"\";",
  "  flex: 1 1 auto;",
